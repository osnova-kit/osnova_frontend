{
  "name": "osnova_frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "biome check .",
    "preview": "vite preview",
    "format": "biome check --write .",
    "generate:client": "openapi-ts",
    "images": "node scripts/images.mjs",
    "strip": "node scripts/strip.mjs",
    "upgrade": "node scripts/upgrade.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@sentry/browser": "^11.12.0",
    "antd": "^5.29.3",
    "axios": "^1.21.1",
    "i18next": "^26.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-router-dom": "^7.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
